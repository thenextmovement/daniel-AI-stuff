# Customer Records Ops production/runtime environment.
# Copy to your hoster secret/env UI. Do not commit real values.

SUPABASE_URL=https://klibiejfisijpagzkxls.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

TRELLO_API_KEY=
TRELLO_TOKEN=

# DHL Express arrivals -> Shopify -> DPD label planning (dry-run by default).
ARRIVAL_LABEL_AGENT_API_TOKEN=
# Separate credential for the outbound-only macOS schedule; do not reuse the n8n token.
ARRIVAL_LABEL_LOCAL_SCHEDULER_API_TOKEN=
ARRIVAL_LABEL_TRELLO_BOARD_ID=62bae9b97705e7419ed64593
ARRIVAL_LABEL_REPORT_DIR=/app/var/arrival-labels/reports
ARRIVAL_LABEL_STORAGE_BUCKET=arrival-labels-private
DHL_EXPRESS_SENDER_DOMAINS=dhl.com,dpdhl.com,dhl.de
# Keep false until a reviewed dry run, confirmed DPD product mapping and EasyDPD API approval.
ARRIVAL_LABEL_WRITES_ENABLED=false

# Local office print worker. Configure these on the LAN worker, not in browser code.
ARRIVAL_LABEL_PRINT_API_URL=https://ops.neontrip.de
ARRIVAL_LABEL_PRINT_API_TOKEN=
# Optional only when the Ops endpoint is protected by a Cloudflare Access service-token policy.
ARRIVAL_LABEL_PRINT_CF_ACCESS_CLIENT_ID=
ARRIVAL_LABEL_PRINT_CF_ACCESS_CLIENT_SECRET=
ARRIVAL_LABEL_PRINT_WORKER_ID=
ARRIVAL_LABEL_PRINTER_KEY=
ARRIVAL_LABEL_CUPS_PRINTER=
ARRIVAL_LABEL_PRINT_MEDIA=
ARRIVAL_LABEL_PRINT_POLL_SECONDS=15
ARRIVAL_LABEL_PRINT_CONFIRM_SECONDS=120

SHIPPING_AGENT_API_TOKEN=
SUPPLIER_PRICE_REVIEW_AGENT_API_TOKEN=
DESIGN_WORKER_API_KEY=

OPS_CLOUDFLARE_ACCESS_ISSUER=https://<team-name>.cloudflareaccess.com
OPS_CLOUDFLARE_ACCESS_AUD=
OPS_REQUIRE_CLOUDFLARE_ACCESS=true

# Recommended allowlist on top of the Cloudflare Access policy.
OPS_ALLOWED_EMAIL_DOMAINS=neontrip.de
# OPS_ALLOWED_EMAILS=person1@neontrip.de,person2@neontrip.de
# Explicit Cloudflare Access service-token client IDs allowed at the origin.
# OPS_ALLOWED_ACCESS_SERVICE_TOKEN_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.access

# Optional integrations.
OPS_PLACETEL_CONTACT_URL_TEMPLATE=
NEONTRIP_OFFERS_BASE_URL=https://angebote.neontrip.de
NEONTRIP_OFFERS_INTERNAL_API_KEY=
MICROSOFT_CLARITY_PROJECT_ID=

# Company Brain: optional read-only Microsoft Graph / Outlook live search.
# Required Azure app permissions: Microsoft Graph Application permission `Mail.Read`
# for the mailbox below, preferably scoped by an Exchange application access policy.
# Secrets stay server-side in Coolify/runtime env and are never exposed to the browser.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_ID_NEXT=
MICROSOFT_GRAPH_CLIENT_SECRET=
# Optional rotation slot. When set, this takes precedence and leaves the prior secret as rollback.
MICROSOFT_GRAPH_CLIENT_SECRET_NEXT=
MICROSOFT_GRAPH_MAILBOX=support@neontrip.de

# Company Brain: optional read-only n8n execution/workflow diagnostics.
# The API key must be read-only/limited where possible. Customer sends stay guarded by app logic.
N8N_API_URL=
# N8N_BASE_URL=              # Alternative to N8N_API_URL; /api/v1 is appended automatically.
N8N_API_KEY=

# Company Brain: optional read-only Coolify health diagnostics.
# This is separate from the deploy webhook used by GitHub Actions.
COOLIFY_API_URL=
# COOLIFY_URL=               # Alternative to COOLIFY_API_URL; /api/v1 is appended automatically.
COOLIFY_API_TOKEN=
COOLIFY_APPLICATION_UUID=

# Sales-Vergabe: accepted offers / Shopify orders into Ops.
# SUPPLIER_SALES_AGENT_API_TOKEN must match the token configured in neontrip-offers.
SUPPLIER_SALES_AGENT_API_TOKEN=
SUPPLIER_SALES_WEBHOOK_SECRET=

# Sales-Vergabe: Shopify Admin tag sync after supplier assignment.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_SHOP_DOMAIN=neontrip.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-01
SUPPLIER_TAG_QUENTIN=Quentin (noch bezahlen)
SUPPLIER_TAG_SAID=Saeid (schon bezahlt)
SUPPLIER_TAG_SPECIAL=

# Sales-Vergabe: Trello supplier projection. Supabase remains source of truth.
SUPPLIER_TRELLO_QUENTIN_LIST_ID=
SUPPLIER_TRELLO_SAID_LIST_ID=
SUPPLIER_TRELLO_SPECIAL_LIST_ID=

# Sales-Vergabe: optional deterministic payment-reminder workflow.
SUPPLIER_PAYMENT_REMINDER_WEBHOOK_URL=
# Sales-Vergabe: optional Outlook/n8n workflow for manual AB-PDF customer emails.
SUPPLIER_ORDER_CONFIRMATION_WEBHOOK_URL=
SHOPIFY_NO_PAYMENT_REMINDER_TAG=Keine Zahlungserinnerung n8n
SUPPLIER_ASSIGNMENT_TASKS_ENABLED=false
SUPPLIER_ASSIGNMENT_TASK_ASSIGNEE=Fabienne
SUPPLIER_PAYMENT_TASK_ASSIGNEE=Fabienne

# Internal Ops Copilot. Server-side only; never expose this as NEXT_PUBLIC_*.
OPS_OPENAI_API_KEY=
OPS_COPILOT_OPENAI_MODEL=gpt-5
# Voice Copilot remains fail-closed until both flags are explicitly enabled.
VOICE_COPILOT_KNOWLEDGE_ENABLED=false
VOICE_LIVE_COPILOT_ENABLED=false
# Optional overrides. Suggestions fall back to OPS_COPILOT_OPENAI_MODEL.
VOICE_COPILOT_SUGGESTION_MODEL=
VOICE_COPILOT_EXTRACTION_MODEL=
VOICE_COPILOT_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPS_OPENAI_IMAGE_MODEL=gpt-image-1.5
OPS_OPENAI_IMAGE_EDIT_MODEL=gpt-image-1.5
DESIGN_ASSET_BUCKET=design-assets
DESIGN_SOURCE_IMAGE_HOSTS=
# Optional: direct generator/n8n webhook for Customer Records visual requests.
# If unset, visual requests are stored as internal tasks instead of calling n8n.
OPS_VISUAL_REQUEST_WEBHOOK_URL=
OPS_VISUAL_REQUEST_WEBHOOK_TOKEN=

# Optional fallback for Shipping Agent API writes.
# n8n currently writes directly to Supabase REST/RPC, but this keeps the API path protected if used later.
SHIPPING_AGENT_API_TOKEN=

# Preview/tunnel only. Leave unset in production when Cloudflare Access is required.
# OPS_PORTAL_TOKEN=
# Separate revocable operator token for the Agent Control Tower.
# CONTROL_TOWER_OPS_PORTAL_TOKEN=
