      "parameters": {
        "jsCode": "// Manual edits on the inquiry board own the entire card's AI field projection.\n// Read live Trello history immediately before writing; never infer ownership\n// from a nonempty value or member ID (the API uses the same member as the UI).\nfunction manualFieldAuthority(card) {\n  const board = '63d10c34105771f01ccf4296';\n  if (!card || !card.id || card.closed || card.idBoard !== board)\n    return {allowed:false, reason:'card_outside_active_inquiry_board'};\n  if (!Array.isArray(card.actions)) throw new Error('MANUAL_FIELD_HISTORY_UNAVAILABLE');\n  for (const action of card.actions) {\n    if (!action || action.type !== 'updateCustomFieldItem') continue;\n    if (action.data?.card?.id !== card.id) throw new Error('MANUAL_FIELD_HISTORY_CARD_MISMATCH');\n    if (action.data?.board?.id !== board) continue;\n    // Native Trello edits have no appCreator. Missing provenance also stops AI.\n    // Empty/cleared fields count too, and RETRY does not release manual ownership.\n    if (!action.appCreator?.id)\n      return {allowed:false, reason:'manual_custom_fields', actionId:action.id, date:action.date};\n  }\n  // Never assume old manual edits are absent when the history was truncated.\n  if (card.actions.length >= 1000) throw new Error('MANUAL_FIELD_HISTORY_TRUNCATED');\n  return {allowed:true, reason:'automated_fields_only'};\n}\n\n\nconst FIELD_MAP={\"price_1\":\"67ab3fba2e8c6d28a877db45\",\"size_1\":\"67989c3214f0ccb08ff6bea4\",\"price_2\":\"67ab3fc552ca87d0b4d96044\",\"size_2\":\"67989c83b14e7b89fb545dc4\",\"price_3\":\"67f4fa9720c565f324c945b8\",\"size_3\":\"67f4faad01083793715a3aac\",\"price_4\":\"67f4faf657f304d308f1435b\",\"size_4\":\"67f4fb02b7f3aaf40ae0636d\"};\nconst BOARD='63d10c34105771f01ccf4296',LIST='659ffc4e5f8bffd67fe38265';\nfunction fields(card){return Object.fromEntries(Object.entries(FIELD_MAP).map(([k,id])=>{const v=(card.customFieldItems||[]).find(f=>f.idCustomField===id)?.value;return [k,v?.text??v?.number??null]}));}\nfunction imageOf(card){return (card.attachments||[]).find(a=>[a.name,a.fileName].some(n=>String(n||'').toLowerCase()==='image.png'));}\nfunction pdfOf(card){const a=(card.attachments||[]).filter(a=>/\\.pdf$/i.test(a.fileName||a.name||'')&&!/invoice|rechnung|angebot|rfq|annex|receipt|agb/i.test(a.name||''));return a.length===1?a[0]:null;}\nfunction attachmentURL(card,a){return a?'https://api.trello.com/1/cards/'+card.id+'/attachments/'+a.id+'/download/'+encodeURIComponent(a.fileName||a.name):null;}\nfunction num(v){if(typeof v==='number')return Number.isFinite(v)?v:null;if(typeof v!=='string')return null;const s=v.trim().replace(',','.');if(!/^(?:EUR|USD|€|\\$)?\\s*\\d+(?:\\.\\d+)?\\s*(?:EUR|USD|€|\\$)?$/i.test(s))return null;return Number(s.replace(/[^\\d.]/g,''));}\nconst SIZE_TOLERANCE_CM=1;\nfunction hasValue(v){return v!==null&&v!==undefined&&String(v).trim()!=='';}\nfunction size(v){const m=String(v||'').match(/^\\s*(\\d+(?:[.,]\\d+)?)\\s*(?:cm\\s*)?(?:[x×]\\s*(\\d+(?:[.,]\\d+)?)\\s*(?:cm)?)?\\s*$/i);if(!m)return null;const w=Number(m[1].replace(',','.')),h=m[2]===undefined?null:Number(m[2].replace(',','.'));return w>0&&(h===null||h>0)?{w,h}:null;}\n// One dimension denotes the longest edge. Two dimensions allow rotated orientation.\n// Compare raw centimetres per edge; round only the stored output, never the tolerance.\nfunction sizeDelta(v,s){if(!s||s.w===null||s.w===undefined)return Infinity;if(s.h===null)return Math.abs(Math.max(v.width_cm,v.height_cm)-s.w);return Math.min(Math.max(Math.abs(v.width_cm-s.w),Math.abs(v.height_cm-s.h)),Math.max(Math.abs(v.width_cm-s.h),Math.abs(v.height_cm-s.w)));}\nfunction dimensionsAgree(a,b){return sizeDelta(a,{w:b.width_cm,h:b.height_cm})<=SIZE_TOLERANCE_CM+1e-9;}\nfunction roundedSourceSize(v,oneDimension=false){return (oneDimension?[Math.max(v.width_cm,v.height_cm)]:[v.width_cm,v.height_cm]).map(Math.round).join('x')+'cm';}\nfunction parseVision(v){if(v?.signs)return v;let x=v?.message?.content??v?.content??v?.text??v?.output??v?.data;if(Array.isArray(x))x=x.map(y=>y.text||'').join('');return JSON.parse(String(x||'').replace(/^\\s*\\x60\\x60\\x60(?:json)?/i,'').replace(/\\x60\\x60\\x60\\s*$/,'').trim());}\nfunction variants(v){if(!Array.isArray(v?.signs))throw new Error('Vision-Antwort enthaelt keine signs');const vs=v.signs.flatMap(s=>Array.isArray(s.variants)?s.variants:[]);if(!vs.length||vs.length>4)throw new Error('Keine eindeutig pruefbaren 1-4 Varianten');for(const s of vs){if(![s.width_cm,s.height_cm,s.total_price_usd].every(x=>typeof x==='number'&&Number.isFinite(x)&&x>0))throw new Error('Dimensionen oder Gesamtpreis nicht eindeutig lesbar');if(s.width_cm>3000||s.height_cm>3000||s.total_price_usd>100000)throw new Error('Werte ausserhalb des plausiblen Bereichs');}return vs;}\nfunction compare(extract,raw){let v,vs;const errors=[],warnings=[],matches=[];try{v=parseVision(raw);vs=variants(v);if(!['high','medium'].includes(v.confidence))throw new Error('Vision-Konfidenz zu niedrig');}catch(e){return {...extract,status:'FAILED',errors:['Vision unklar: '+e.message],warnings,matches,summary:'QC fehlgeschlagen - keine verlaessliche Vision-Antwort',visionData:null,signsFromImage:[]};}\n const cf=extract.customFields||{},sets=[];for(let j=1;j<=4;j++){if(hasValue(cf['size_'+j])||hasValue(cf['price_'+j])){const wh=size(cf['size_'+j]);sets.push({index:j,w:wh?.w??null,h:wh?.h??null,price:num(cf['price_'+j])});}}\n if(vs.length!==sets.length)errors.push('Anzahl Varianten: Bild='+vs.length+', Custom Fields='+sets.length);\n const used=new Set();const matched=[];\n for(let i=0;i<vs.length;i++){const a=vs[i];const ranked=sets.filter(s=>!used.has(s.index)).map(s=>({s,score:(s.price===null?999999:Math.abs(a.total_price_usd-s.price))*1000+(s.w===null?999999:sizeDelta(a,s))})).sort((a,b)=>a.score-b.score);const s=ranked[0]?.s;if(!s){errors.push('Variante '+(i+1)+': kein Custom-Field-Satz');continue;}used.add(s.index);matched.push({variant:i,field_index:s.index});\n  if(s.price===null)errors.push('price_'+s.index+' fehlt oder ist ungueltig');else{const d=Math.abs(a.total_price_usd-s.price);if(d>3&&d/s.price>0.05)errors.push('Variante '+(i+1)+' PREIS: Quelle='+a.total_price_usd+', CF='+s.price);else matches.push('Price_'+s.index+' stimmt innerhalb Toleranz');}\n  if(s.w===null)errors.push('size_'+s.index+' fehlt oder ist ungueltig');else{const d=sizeDelta(a,s);if(d>SIZE_TOLERANCE_CM+1e-9)errors.push('Variante '+(i+1)+' GROESSE: Quelle='+a.width_cm+'x'+a.height_cm+'cm, CF='+s.w+(s.h===null?'':'x'+s.h)+'cm');else matches.push('Size_'+s.index+' stimmt innerhalb Toleranz');}\n }\n return {...extract,status:errors.length?'FAILED':'VERIFIED',errors,warnings,matches,summary:errors.length?'QC fehlgeschlagen - '+errors.length+' Fehler':'QC bestanden - '+vs.length+' Variante(n)',visionData:v,visionConfidence:v.confidence,signsFromImage:vs.map(s=>({width:s.width_cm,height:s.height_cm,price:s.total_price_usd})),customFieldSets:sets,matchedSets:matched};\n}\nfunction sourceKey(card){const image=imageOf(card),pdf=pdfOf(card);return 'qc_auto_repair_v1:'+card.id+':'+(image?.id||'no-image')+':'+(pdf?.id||'no-pdf');}\n\nreturn $input.all().map((item,i)=>{const ctx=$('Validate QC Correction Proposal').itemMatching(i).json,c=item.json;if(c.id!==ctx.cardId||c.closed||c.idBoard!==BOARD||c.idList!==LIST)throw new Error('QC_CARD_MOVED_OR_MISMATCH: '+ctx.cardId);if(sourceKey(c)!==ctx.sourceKey)throw new Error('QC_SOURCE_CHANGED: '+ctx.cardId);const current=fields(c);let changes=ctx.correctionChanges||[];let blocked=ctx.correctionBlockedReason;const ownership=manualFieldAuthority(c);if(!ownership.allowed){changes=[];blocked='Manuell bearbeitete Karte: automatische Custom-Field-Korrektur gesperrt';}if(Object.keys(FIELD_MAP).some(k=>String(current[k]??'')!==String(ctx.customFields[k]??''))){changes=[];blocked='Custom Fields wurden zwischenzeitlich geaendert; frische Nachpruefung ohne Ueberschreiben';}for(const x of changes)if(FIELD_MAP[x.field]!==x.idCustomField||typeof x.value?.text!=='string')throw new Error('QC_INVALID_FIELD_PROPOSAL');// QC_FIELD_WRITES_DISABLED_20260925: QC reports discrepancies; it never overwrites card fields.\nchanges=[];blocked='Automatische Custom-Field-Korrektur deaktiviert. Bestehende Werte bleiben unveraendert; Abweichungen manuell pruefen.';\nreturn {json:{...ctx,correctionChanges:changes,correctionBlockedReason:blocked,hasCorrections:changes.length>0},pairedItem:{item:i}};});"
      }
    },
