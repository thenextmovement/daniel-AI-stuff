    {
      "id": "x-needed",
      "name": "Has Pending Contexts",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "x-needed-condition",
              "leftValue": "={{ $json.pending === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "x-orders",
      "name": "Read Paid Order Associations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "url": "={{ \"https://galaxybuzzdk.myshopify.com/admin/api/2026-07/orders.json?status=any&financial_status=paid&limit=250&fields=id,checkout_token&updated_at_min=\" + encodeURIComponent($now.minus({days:30}).toISO()) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ (($response.headers.link || \"\").match(/<([^>]+)>; rel=\"next\"/) || [\"\", \"\"])[1] }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.headers.link || !$response.headers.link.includes('rel=\"next\"') }}",
              "limitPagesFetched": true,
              "maxRequests": 20,
              "requestInterval": 600
            }
          }
        }
      },
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "WZah58udMOwKiRR3",
          "name": "Shopify Access Token account"
        }
      }
    },
    {
      "id": "x-bundle",
      "name": "Validate Association Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        240
      ],
      "parameters": {
        "jsCode": "const pages = $input.all().map(i => i.json);\nif (pages.some(p => p.statusCode !== 200 || !Array.isArray(p.body?.orders))) throw new Error(\"Shopify association read failed\");\nif ((pages.at(-1)?.headers?.link || \"\").includes('rel=\"next\"')) throw new Error(\"Shopify pagination incomplete\");\nreturn [{json:{action:\"associate\",orders:pages.flatMap(p=>p.body.orders.map(o=>({id:String(o.id),checkout_token:o.checkout_token})))}}];"
      }
    },
    {
      "id": "x-associate",
      "name": "Associate Consented Checkouts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
