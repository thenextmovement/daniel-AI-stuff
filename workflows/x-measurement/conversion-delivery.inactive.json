        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json",
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "oAuth1Api": {
          "id": "o8ZFzyjOQTAPdXXa",
          "name": "NEONTRIP X Ads Conversion API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "x-receipt",
