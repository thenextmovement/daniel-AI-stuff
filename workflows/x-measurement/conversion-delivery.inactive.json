    {
      "id": "x-pending",
      "name": "Check Pending Contexts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ops.neontrip.de/api/internal/measurement/x",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action: \"pending\" } }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "52s73ZL3sfST19A8",
          "name": "NEONTRIP Billing Worker"
        }
