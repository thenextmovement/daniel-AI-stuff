      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        240
      ],
      "parameters": {
        "url": "={{ \"https://galaxybuzzdk.myshopify.com/admin/api/2026-07/orders/\" + $json.job.order_id + \".json?fields=id,checkout_token,financial_status,test,cancelled_at,total_price,currency\" }}",
