        "url": "https://ops.neontrip.de/api/internal/measurement/x",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { action: \"receipt\", job: $(\"Claim One Purchase\").first().json.job, response: { statusCode: $json.statusCode || 0, body: { data: $json.body?.data || null, errors: Boolean($json.body?.errors) } } } }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "52s73ZL3sfST19A8",
          "name": "NEONTRIP Billing Worker"
        }
      }
    }
