    {
      "id": "x-payment",
      "name": "Read Shopify Payment Evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://galaxybuzzdk.myshopify.com/admin/api/2026-07/graphql.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { query: \"query XPaymentProof($id: ID!) { order(id: $id) { id displayFinancialStatus test cancelledAt totalPriceSet { shopMoney { amount currencyCode } } totalReceivedSet { shopMoney { amount currencyCode } } transactions(first: 100) { id status kind manualPaymentGateway test processedAt amountSet { shopMoney { amount currencyCode } } } } }\", variables: { id: \"gid://shopify/Order/\" + $(\"Claim One Purchase\").first().json.job.order_id } } }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "WZah58udMOwKiRR3",
          "name": "Shopify Access Token account"
        }
      }
    },
    {
