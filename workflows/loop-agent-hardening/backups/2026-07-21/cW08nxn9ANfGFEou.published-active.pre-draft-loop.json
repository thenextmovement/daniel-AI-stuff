    {
      "parameters": {
        "jsCode": "const context = $('Prepare Email Context').first().json;\nconst aiOutput = $json.message?.content || $json.text || $json;\n\nconst HTML_SIGNATURE = `\n<br><br>\n<table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.6; color: #333333; max-width: 600px;\">\n    <tbody>\n        <tr>\n            <td style=\"padding: 0;\">\n                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                    <tbody>\n                        <tr>\n                            <td colspan=\"2\" style=\"padding-bottom: 20px;\">\n                                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                                    <tbody>\n                                        <tr>\n                                            <td valign=\"middle\" style=\"padding-right: 20px; width: 120px;\">\n                                                <img src=\"https://cdn.shopify.com/s/files/1/0534/7819/5350/files/fabienne123.jpg?v=1764000653\" \n                                                     alt=\"Fabienne Trapp\" \n                                                     style=\"width: 100px; height: 100px; border-radius: 50%; display: block; object-fit: cover;\">\n                                            </td>\n                                            <td valign=\"top\">\n                                                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                                                    <tbody>\n                                                        <tr><td style=\"padding-bottom: 5px;\"><strong style=\"font-size: 16px; color: #2C3E50;\">Fabienne Trapp</strong></td></tr>\n                                                        <tr><td style=\"padding-bottom: 12px;\"><span style=\"color: #7F8C8D; font-size: 13px;\">Beratung & Realisierung</span></td></tr>\n                                                        <tr><td style=\"padding-bottom: 2px;\"><span style=\"color: #2C3E50; font-weight: 600;\">NEONTRIP®</span></td></tr>\n                                                        <tr><td style=\"padding-top: 8px; padding-bottom: 2px;\"><span style=\"color: #555555; font-size: 13px;\">Tel: +49 211 54257240</span></td></tr>\n                                                        <tr><td style=\"padding-bottom: 2px;\"><span style=\"color: #555555; font-size: 13px;\">E-Mail: <a href=\"mailto:support@neontrip.de\" style=\"color: #4A90E2; text-decoration: none;\">support@neontrip.de</a></span></td></tr>\n                                                        <tr><td style=\"padding-bottom: 2px;\"><span style=\"color: #555555; font-size: 13px;\">Web: <a href=\"https://www.neontrip.de\" style=\"color: #4A90E2; text-decoration: none;\">www.neontrip.de</a></span></td></tr>\n                                                        <tr><td style=\"padding-top: 2px;\"><span style=\"color: #555555; font-size: 13px;\">Adresse: Bilker Allee 29, 40219 Düsseldorf</span></td></tr>\n                                                    </tbody>\n                                                </table>\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </td>\n                        </tr>\n                        <tr>\n                            <td colspan=\"2\" style=\"padding-top: 20px;\">\n                                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #121212; border-radius: 8px; padding: 20px; text-align: center;\">\n                                    <tbody>\n                                        <tr>\n                                            <td align=\"center\">\n                                                <div style=\"font-size: 32px; font-weight: bold; color: #FFFFFF; letter-spacing: 2px; font-family: Arial, sans-serif;\">NEON<span style=\"color: #00FF88;\">⚡</span>TRIP</div>\n                                                <div style=\"margin-top: 8px; font-size: 11px; color: #FFFFFF; letter-spacing: 0.5px; font-weight: 300;\">UNIQUE LIGHTING AND BRANDING</div>\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </td>\n        </tr>\n    </tbody>\n</table>`;\n\nlet parsed;\ntry {\n  if (typeof aiOutput === 'string') {\n    const jsonMatch = aiOutput.match(/\\{[\\s\\S]*\\}/);\n    parsed = JSON.parse(jsonMatch ? jsonMatch[0] : aiOutput);\n  } else {\n    parsed = aiOutput;\n  }\n} catch (e) {\n  parsed = {\n    subject: `NEONTRIP — Neues Projekt geplant, ${context.greeting_name}?`,\n    body: `Hallo ${context.greeting_name},<br><br>hier ist Fabienne von NEONTRIP. Ihre letzte Bestellung liegt nun ${context.months_since_last_order} Monate zurück — gibt es ein neues Projekt, bei dem wir Sie unterstützen können?<br><br>Herzliche Grüße<br>Fabienne`\n  };\n}\n\n// Append signature to body\nconst fullBody = parsed.body + HTML_SIGNATURE;\n\nreturn [{\n  json: {\n    to: context.email,\n    subject: parsed.subject,\n    body: fullBody,\n    customer_id: context.customer_id,\n    customer_email: context.email,\n    customer_name: `${context.first_name || ''} ${context.last_name || ''}`.trim(),\n    company_name: context.company_name,\n    last_order_date: context.last_order_date,\n    last_order_value: context.last_order_value,\n    total_orders: context.order_count,\n    total_revenue: context.total_spent\n  }\n}];"
      },
