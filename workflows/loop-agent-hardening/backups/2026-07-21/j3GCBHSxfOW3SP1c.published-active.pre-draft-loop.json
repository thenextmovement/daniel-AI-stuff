    {
      "id": "note-info",
      "name": "Post-Delivery Info",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        80
      ],
      "parameters": {
        "content": "## NEONTRIP Post-Delivery Flow v1.0\n\n**Trigger:** Täglich 10:00 Uhr\n**Batch:** 10 Kunden pro Tag\n**Ziel:** Nach zugestellter Bestellung + Review-Anfrage:\n- Foto vom montierten Schild anfragen\n- Weiterempfehlung erbitten\n- Bei High-Value (>2000€): Case Study anfragen\n\n**Timing:** 7 Tage nach Review-Anfrage\n**Dedupe:** Nur 1x pro Order",
        "width": 350,
        "height": 260
      }
    },
    {
      "id": "lookup-outlook",
      "name": "Lookup Outlook History",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        880,
