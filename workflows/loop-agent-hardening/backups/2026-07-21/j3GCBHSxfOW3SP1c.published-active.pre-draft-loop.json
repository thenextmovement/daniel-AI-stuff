    {
      "id": "log-outreach",
      "name": "Log to Supabase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "const item = $json;\nconst types = item.outreach_types || ['referral', 'photo_request'];\n\n// Create one log entry per outreach type\nconst logs = types.map(type => ({\n  order_id: item.order_id,\n  order_number: item.order_number,\n  customer_email: item.customer_email,\n  customer_name: item.customer_name,\n  order_value: item.order_value,\n  outreach_type: type,\n  status: 'sent'\n}));\n\nreturn logs.map(log => ({ json: log }));"
      }
    },
