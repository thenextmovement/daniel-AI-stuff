      },
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "CTEmJD5CjYu9hawu",
          "name": "Microsoft Outlook support@neontrip.de"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "lookup-pandadoc",
      "name": "Lookup PandaDoc Quotes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://klibiejfisijpagzkxls.supabase.co/rest/v1/v_quotes_by_email?email=eq.{{ encodeURIComponent($('Determine Outreach Type').first().json.customer_email) }}&select=document_id,customer_name,status,total_value,created_at,signed_at&order=created_at.desc&limit=3",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "NTtNxoBGGzJCQi9u",
          "name": "Header Auth account 2 | SUPABASE"
        }
      },
      "continueOnFail": true
    },
    {
      "id": "prepare-delivery-context",
      "name": "Prepare Delivery Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const context = $('Determine Outreach Type').first().json;\n\n// Outlook email history\nconst outlookItems = $('Lookup Outlook History').all().map(i => i.json);\nconst emailHistory = outlookItems\n  .filter(e => e.subject)\n  .map(e => `[${(e.receivedDateTime || '').substring(0,10)}] ${e.subject}`)\n  .slice(0, 6);\n\n// PandaDoc quotes\nconst pandadocItems = $('Lookup PandaDoc Quotes').all().map(i => i.json);\nconst quotes = pandadocItems\n  .filter(q => q.document_id)\n  .map(q => `${q.status} | ${q.total_value}EUR | ${(q.created_at || '').substring(0,10)}`);\n\nreturn [{\n  json: {\n    ...context,\n    email_history: emailHistory.length > 0 ? emailHistory.join('\\n') : 'Keine E-Mail-Historie',\n    quote_history: quotes.length > 0 ? quotes.join('\\n') : 'Keine Angebote',\n    email_count: emailHistory.length,\n    quote_count: quotes.length\n  }\n}];"
      }
    }
  ],
