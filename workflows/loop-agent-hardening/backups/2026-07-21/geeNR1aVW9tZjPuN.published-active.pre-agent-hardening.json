    {
      "parameters": {
        "jsCode": "const repo = $('GitHub Get Status').first().json;\nconst prs = $('Get Open PRs').all();\nconst issues = $('Get Open Issues').all();\nconst commits = $('Get Recent Commits').all().slice(0, 5);\n\n// Get chatId from Parse & Validate node (not from merged GitHub data)\nconst chatId = $('Parse & Validate').first().json.chatId;\n\nlet message = `📊 *Status for ${repo.full_name}*\\n\\n`;\nmessage += `⭐ Stars: ${repo.stargazers_count}\\n`;\nmessage += `🔱 Forks: ${repo.forks_count}\\n`;\nmessage += `👀 Watchers: ${repo.watchers_count}\\n\\n`;\n\nmessage += `📝 *Open PRs: ${prs.length}*\\n`;\nif (prs.length > 0) {\n  prs.slice(0, 3).forEach(pr => {\n    message += ` • #${pr.json.number}: ${pr.json.title}\\n`;\n  });\n}\n\nmessage += `\\n🐛 *Open Issues: ${issues.length}*\\n`;\nif (issues.length > 0) {\n  issues.slice(0, 3).forEach(issue => {\n    message += ` • #${issue.json.number}: ${issue.json.title}\\n`;\n  });\n}\n\nmessage += `\\n📌 *Recent Commits:*\\n`;\ncommits.forEach(commit => {\n  const msg = commit.json.commit.message.split('\\n')[0];\n  message += ` • ${msg.substring(0, 50)}...\\n`;\n});\n\nreturn {\n  json: {\n    chatId: chatId,\n    message: message\n  }\n};"
      },
