    {
      "parameters": {
        "jsCode": "const workflows = $input.first().json.workflows;\nconst targetName = $input.first().json.details || '';\n\nlet workflow = workflows.find(w => w.name.toLowerCase().includes(targetName.toLowerCase()));\nif (!workflow && workflows.length > 0) {\n  workflow = workflows.find(w => w.state === 'active') || workflows[0];\n}\n\nif (!workflow) {\n  throw new Error('No workflow found');\n}\n\nreturn {\n  json: {\n    repo: $input.first().json.repo,\n    workflowId: workflow.id,\n    workflowName: workflow.name,\n    chatId: $input.first().json.chatId\n  }\n};"
      },
