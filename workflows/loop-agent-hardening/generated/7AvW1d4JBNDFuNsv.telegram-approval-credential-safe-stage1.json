      "id": "attcheck",
      "name": "Anhang prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "jsCode": "const evt = $('Filter: Neue Anfrage').item.json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.card_id);\nif (rows.length === 0) return []; // Karte (noch) nicht gemeldet -> ignorieren\nconst row = rows[0];\nif (!row.message_id) return []; // Hauptnachricht noch nicht raus -> Haupt-Flow schickt den Anhang mit\nconst sent = Array.isArray(row.sent_attachments) ? row.sent_attachments : [];\nif (sent.includes(evt.att_id)) return []; // schon geschickt\n\nconst fn = evt.att_name || (evt.att_id + '.bin');\nconst isImage = /\\.(jpe?g|png|webp|gif|bmp)($|\\?)/i.test(fn);\nreturn [{ json: {\n  card_id: evt.card_id,\n  chat_id: evt.chat_id,\n  att_id: evt.att_id,\n  filename: fn,\n  is_image: isImage,\n  download_url: 'https://api.trello.com/1/cards/' + evt.card_id + '/attachments/' + evt.att_id + '/download/' + encodeURIComponent(fn),\n  caption: '📎 Nachgereichter Anhang: ' + fn + ' — gehört zur Anfrage „' + (row.card_name || evt.card_name) + '“',\n  sent_attachments: sent\n} }];"
      }
