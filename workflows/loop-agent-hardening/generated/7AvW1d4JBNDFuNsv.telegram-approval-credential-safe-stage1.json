    {
      "id": "build",
      "name": "Nachricht bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -100
      ],
      "parameters": {
        "jsCode": "const ANFRAGEN_LIST = '64ca588f8bd547afc087a6ea';\nconst base = $('Nur neue Fälle').item.json;\nconst card = $('Trello: Karte laden').item.json;\n\n// Karte muss noch in der Anfragen-Liste sein\nif (!card || card.idList !== ANFRAGEN_LIST) return [];\n\nconst reqRows = $('Supabase: Request').all().map(i => i.json).filter(r => r && (r.request_id || r.customer_id || r.description));\nconst req = reqRows[0] || {};\nconst custRows = $input.all().map(i => i.json).filter(r => r && (r.email || r.first_name || r.name));\nconst cust = custRows[0] || {};\n\nfunction esc(s) {\n  return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n\n// Name bestimmen\nlet name = [cust.first_name, cust.last_name].filter(Boolean).join(' ') || cust.name || '';\nif (!name) name = (card.name || '').split('|')[0].trim();\nconst company = cust.company_name || cust.company || '';\nconst email = cust.email || '–';\nconst phone = cust.phone || '–';\n\n// Original-Kundentext: IMMER KOMPLETT, nie kürzen\nlet original = (req.description || '').trim();\nconst desc = card.desc || '';\nif (!original) {\n  const markers = [/📧 ORIGINAL NACHRICHT[^:]*:/i, /Original Nachricht[^:]*:/i, /\\bNachricht:\\s*/];\n  for (const m of markers) {\n    const match = desc.match(m);\n    if (match) {\n      let rest = desc.slice(match.index + match[0].length);\n      const cut = rest.indexOf('---');\n      if (cut > 0) rest = rest.slice(0, cut);\n      original = rest.trim();\n      if (original) break;\n    }\n  }\n}\nif (!original) original = desc.trim() || '(kein Text gefunden)';\n\nconst headerTop = '🆕 <b>Neue Anfrage</b> von: <b>' + esc(name) + '</b>' + (company ? ' (' + esc(company) + ')' : '') + '\\n📧 ' + esc(email) + '\\n📞 ' + esc(phone);\nconst linkLine = '🔗 ' + (card.shortUrl || '');\n\nconst fullMsg = headerTop + '\\n\\n💬 <b>Kundennachricht:</b>\\n' + esc(original) + '\\n\\n' + linkLine;\n\nlet message_text;\nconst text_chunks = [];\nif (fullMsg.length <= 3800) {\n  message_text = fullMsg;\n} else {\n  // Kompletter Text in eigenen Nachrichten (nie kürzen), Buttons-Nachricht verweist darauf\n  for (let i = 0; i < original.length; i += 3500) {\n    text_chunks.push(original.slice(i, i + 3500));\n  }\n  message_text = headerTop + '\\n\\n💬 <b>Kundennachricht:</b> komplett in den Nachrichten darüber ⬆️\\n\\n' + linkLine;\n}\n\nconst kb = { inline_keyboard: [\n  [\n    { text: '✅ Ja', callback_data: 'ok:' + base.card_id },\n    { text: '❌ Nein', callback_data: 'no:' + base.card_id }\n  ],\n  [ { text: '✏️ Änderung', callback_data: 'edit:' + base.card_id } ]\n] };\n\n// ALLE Attachments: Bilder als Foto, Rest als Dokument (EPS, PDF, ZIP, egal was)\nconst atts = Array.isArray(card.attachments) ? card.attachments : [];\nconst attachments = [];\nconst att_ids = [];\nfor (const a of atts) {\n  if (!a.id) continue;\n  const fn = a.fileName || a.name || (a.id + '.bin');\n  const isImage = (a.mimeType && a.mimeType.startsWith('image/')) || /\\.(jpe?g|png|webp|gif|bmp)($|\\?)/i.test(a.url || fn);\n  attachments.push({\n    download_url: 'https://api.trello.com/1/cards/' + base.card_id + '/attachments/' + a.id + '/download/' + encodeURIComponent(fn),\n    filename: fn,\n    is_image: isImage,\n    caption: '📎 ' + fn + ' — gehört zur Anfrage von ' + name,\n    chat_id: base.chat_id\n  });\n  att_ids.push(a.id);\n}\n\nreturn [{ json: {\n  chat_id: base.chat_id,\n  card_id: base.card_id,\n  card_name: card.name || base.card_name,\n  card_url: card.shortUrl || '',\n  request_id: req.request_id || null,\n  message_text,\n  text_chunks,\n  reply_markup: kb,\n  attachments,\n  att_ids\n} }];"
      }
    },
