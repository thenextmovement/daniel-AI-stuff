    {
      "id": "filter",
      "name": "Filter: Neue Anfrage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Konfiguration\nconst CHAT_ID = '-5354838907'; // Telegram-Gruppe \"Neontrip Anfragen\"\nconst ANFRAGEN_LIST = '64ca588f8bd547afc087a6ea';\nconst BOARD_ID = '63d10c34105771f01ccf4296';\n\nconst root = $input.first().json || {};\nconst action = (root.body && root.body.action) || root.action;\nif (!action) return [];\n\nconst boardId = action.data && action.data.board && action.data.board.id;\nif (boardId !== BOARD_ID) return [];\n\nconst t = action.type;\nconst card = (action.data && action.data.card) || {};\nif (!card.id) return [];\n\n// Neue Karte in der Anfragen-Liste\nif (t === 'createCard' || (t === 'updateCard' && action.data.listAfter)) {\n  const listId = t === 'createCard'\n    ? (action.data.list && action.data.list.id)\n    : action.data.listAfter.id;\n  if (listId !== ANFRAGEN_LIST) return [];\n  return [{ json: { branch: 'new', card_id: card.id, card_name: card.name || '', chat_id: CHAT_ID, event_type: t } }];\n}\n\n// Nachträglich hinzugefügter Anhang auf einer Karte in der Anfragen-Liste\nif (t === 'addAttachmentToCard') {\n  const listId = action.data.list && action.data.list.id;\n  if (listId !== ANFRAGEN_LIST) return [];\n  const att = action.data.attachment || {};\n  if (!att.id) return [];\n  return [{ json: { branch: 'att', card_id: card.id, card_name: card.name || '', chat_id: CHAT_ID, att_id: att.id, att_name: att.name || 'datei' } }];\n}\n\nreturn [];"
      }
    },
