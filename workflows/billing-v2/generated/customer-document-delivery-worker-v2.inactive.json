    {
      "id": "ab-ids",
      "name": "Order Confirmation Attachment IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1190,
        500
      ],
      "parameters": {
        "jsCode": "\nconst ctx=$('Check Existing Customer Delivery').first().json;\n// This mailbox explicitly permits only one PDF. Keep the invoice on hold rather than send a rejected two-PDF message.\nif(ctx.recipient==='erechnung@duesseldorf.de')throw new Error('FATAL_order_confirmation_single_pdf_mailbox_requires_manual_combined_document');\nconst pdf=$json.body??$json;\nif(!pdf.ok||pdf.contentType!=='application/pdf'||!/^auftragsbestaetigung-[A-Za-z0-9._-]+\\.pdf$/.test(pdf.filename)||!String(pdf.contentBase64||'').startsWith('JVBERi0'))throw new Error('order_confirmation_pdf_invalid');\nconst ids=ctx.easybillDocument.attachment_ids||[];\nreturn (ids.length?ids:[null]).map(id=>({json:{attachmentId:id}}));"
      },
      "onError": "continueErrorOutput"
    },
