    {
      "id": "delivery-blocked",
      "name": "Raise Customer Delivery Block",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        -80
      ],
      "parameters": {
        "jsCode": "const body=$json.body??$json;const prepared=$('Prepare Customer Delivery').all()[0]?.json??{};const claim=$('Claim Customer Delivery Job').all()[0]?.json??{};const claimed=(claim.body??claim).claimed??{};const payload=prepared.job?.payload??claimed.job?.payload??{};const documentNumber=prepared.documentNumber??payload.documentNumber??'UNBEKANNT';const orderName=prepared.shopifyOrderName??payload.shopifyOrderName??claimed.billingCase?.shopify_order_name??'UNBEKANNT';const recipient=prepared.recipient??payload.recipient??'KEINE GUELTIGE EMPFAENGERADRESSE';if(body.completed?.status==='BLOCKED')throw new Error('FATAL Fehler Rechnung Shopify/Easybill: Kundenbeleg '+documentNumber+' zu '+orderName+' konnte nach vier Versuchen nicht an '+recipient+' versendet werden. Bitte sofort in Ops/Rechnungen und Easybill pruefen.');const output={ok:true,status:body.completed?.status||'DONE'};return [{json:output}];"
      }
    },
