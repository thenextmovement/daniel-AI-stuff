    {
      "id": "delivery-check",
      "name": "Check Existing Customer Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -80
      ],
      "parameters": {
        "jsCode": "const ctx=$('Prepare Customer Delivery').first().json;const doc=$json.body??$json;if(!doc.id||String(doc.number||'')!==ctx.documentNumber)throw new Error('billing_customer_delivery_document_mismatch');const output={...ctx,easybillDocument:doc,emailAlreadySent:Boolean(doc.last_postbox_id)};return [{json:output}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "delivery-already-sent",
      "name": "Customer Document Already Sent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.emailAlreadySent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "delivery-send",
