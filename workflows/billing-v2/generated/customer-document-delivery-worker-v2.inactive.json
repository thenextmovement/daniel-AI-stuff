    {
      "id": "ab-upload",
      "name": "Upload Order Confirmation PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2510,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.easybill.de/rest/v1/attachments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
