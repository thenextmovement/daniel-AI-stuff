    {
      "id": "delivery-config",
      "name": "Customer Delivery Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config={opsBaseUrl:'https://ops.neontrip.de',worker:'n8n-customer-document-delivery-v2'};return [{json:config}];"
      }
    },
    {
      "id": "delivery-claim",
      "name": "Claim Customer Delivery Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.opsBaseUrl + '/api/internal/billing/jobs/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {worker:$json.worker,jobTypes:['SEND_CUSTOMER_DOCUMENT'],leaseSeconds:180} }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_BILLING_WORKER_BEARER",
          "name": "NEONTRIP Billing Worker"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "delivery-prepare",
      "name": "Prepare Customer Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst claimed = ($json.body ?? $json).claimed;\nif (!claimed?.job || !claimed?.billingCase) {\n  const empty = {hasJob:false};\n  return [{json:empty}];\n}\nconst job = claimed.job;\nconst billingCase = claimed.billingCase;\nconst payload = job.payload || {};\nconst recipient = String(payload.recipient || '').trim().toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(recipient) || recipient.length > 254) {\n  throw new Error('FATAL_billing_customer_delivery_recipient_missing_or_invalid');\n}\nconst easybillDocumentId = String(payload.easybillDocumentId || '');\nif (!/^\\d+$/.test(easybillDocumentId)) throw new Error('billing_customer_delivery_easybill_id_invalid');\nconst documentNumber = String(payload.documentNumber || '').trim();\nconst shopifyOrderName = String(payload.shopifyOrderName || billingCase.shopify_order_name || '').trim();\nif (!/^#NEONT\\d+$/.test(shopifyOrderName)) throw new Error('billing_customer_delivery_order_number_invalid');\nconst portalUrl = String(payload.portalUrl || '').trim();\nif (!/^https:\\/\\/rechnung\\.neontrip\\.de\\/[A-Za-z0-9_-]+$/.test(portalUrl)) throw new Error('billing_customer_delivery_portal_url_invalid');\nconst projectNumber = String(payload.projectNumber || billingCase.project_number || '').trim();\nif (projectNumber.length > 100 || /[<>\\r\\n]/.test(projectNumber)) throw new Error('billing_customer_delivery_project_number_invalid');\nconst kind = String(payload.deliveryKind || '');\nconst subjects = {\n  ORDER_CONFIRMATION_PROFORMA:'Auftragsbestätigung ' + shopifyOrderName + ' – Ihre Bestellung bei NEONTRIP',\n  PROFORMA_UPDATE:'Aktualisierte Pro-forma-Rechnung ' + documentNumber + ' – NEONTRIP',\n  INVOICE:'Rechnung ' + documentNumber + ' – NEONTRIP',\n  CREDIT:'Gutschrift ' + documentNumber + ' – NEONTRIP',\n  CANCELLATION:'Stornobeleg ' + documentNumber + ' – NEONTRIP'\n};\nif (!subjects[kind]) throw new Error('billing_customer_delivery_kind_invalid');\nconst common = [\n  'Bestellnummer: ' + shopifyOrderName,\n  projectNumber ? 'Projektnummer: ' + projectNumber : '',\n  'Rechnungsdaten und Dokumente: ' + portalUrl,\n  'AGB: https://angebote.neontrip.de/legal/agb'\n].filter(Boolean);\nconst messages = {\n  ORDER_CONFIRMATION_PROFORMA:[\n    'vielen Dank für Ihre verbindliche Bestellung bei NEONTRIP. Hiermit bestätigen wir den Eingang und die Annahme Ihres Auftrags.',\n    'Ihre Pro-forma-Rechnung ' + documentNumber + ' finden Sie als PDF im Anhang. Sie dient als Zahlungsaufforderung und ist keine steuerliche Schlussrechnung.',\n    'Zahlbar sofort. Mit unserer Auftragsbestätigung beginnt die Produktion Ihres individuellen Auftrags bereits. Der Auftrag ist verbindlich. Sollte die Zahlung nicht rechtzeitig eingehen, kann die Produktion vor Fertigstellung pausiert werden. Dadurch kann sich der Liefertermin verschieben.',\n    'Über den folgenden Link können Sie ausschließlich Änderungen zu Ihren Rechnungsdaten anfragen. Änderungen am Auftrag selbst sind dort nicht möglich.'\n  ],\n  PROFORMA_UPDATE:[\n    'die von uns freigegebenen Änderungen an Ihren Rechnungsdaten wurden übernommen.',\n    'Ihre aktualisierte Pro-forma-Rechnung ' + documentNumber + ' finden Sie als PDF im Anhang.'\n  ],\n  INVOICE:[\n    'anbei erhalten Sie Ihre Rechnung ' + documentNumber + ' als PDF.',\n    'Die Rechnung wurde auf Grundlage des bestätigten Auftrags und des aktuellen Zahlungs-/Lieferstatus erstellt.'\n  ],\n  CREDIT:[\n    'anbei erhalten Sie die Gutschrift ' + documentNumber + ' zu Ihrer Bestellung als PDF.',\n    'Der in Shopify erfasste Erstattungsbetrag wurde in diesem Beleg berücksichtigt.'\n  ],\n  CANCELLATION:[\n    'anbei erhalten Sie den Stornobeleg ' + documentNumber + ' zu Ihrer Bestellung als PDF.',\n    'Die Stornierung wurde mit dem zugehörigen Shopify-Auftrag abgeglichen.'\n  ]\n};\nconst message = ['Guten Tag,','',...messages[kind],'',...common,'','Freundliche Grüße','Ihr NEONTRIP-Team'].join('\\n');\nconst output = {\n  hasJob:true,\n  job,\n  billingCase,\n  recipient,\n  easybillDocumentId,\n  documentNumber,\n  shopifyOrderName,\n  portalUrl,\n  kind,\n  subject:subjects[kind],\n  message\n};\nreturn [{json:output}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "delivery-has-job",
      "name": "Has Customer Delivery Job",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -220,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hasJob }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "delivery-load",
      "name": "Easybill Load Customer Document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        -80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.easybill.de/rest/v1/documents/' + encodeURIComponent($json.easybillDocumentId) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
