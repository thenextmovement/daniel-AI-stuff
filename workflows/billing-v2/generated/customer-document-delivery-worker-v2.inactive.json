        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.opsBaseUrl + '/api/internal/billing/jobs/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {worker:$json.worker,jobTypes:['SEND_CUSTOMER_DOCUMENT'],leaseSeconds:180} }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_BILLING_WORKER_BEARER",
          "name": "NEONTRIP Billing Worker"
