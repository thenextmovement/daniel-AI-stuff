      "name": "Select Existing Order Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1850,
        500
      ],
      "parameters": {
        "jsCode": "\nconst pdfResponse=$('Load Order Confirmation PDF').first().json;const pdf=pdfResponse.body??pdfResponse;\nconst ctx=$('Check Existing Customer Delivery').first().json;\nconst existing=$input.all().map(i=>i.json.body??i.json).filter(a=>a.file_name===pdf.filename);\nif(existing.some(a=>String(a.document_id)!==String(ctx.easybillDocumentId)))throw new Error('order_confirmation_attachment_ownership_mismatch');\nreturn [{json:{attached:existing.length>0,attachmentId:existing[0]?.id??null}}];"
      },
