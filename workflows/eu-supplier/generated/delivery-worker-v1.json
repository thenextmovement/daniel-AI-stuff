      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        -200
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = { action: 'delivery_outcome', deliveryId: $('Build Graph Send').item.json.delivery.id, outcome: 'sent', providerMessageId: $('Build Graph Send').item.json.messageId, providerConversationId: $('Build Graph Send').item.json.conversationId, workflowExecutionId: String($execution.id) } ;\nconst raw = JSON.stringify(body);\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst secret = String($env.EU_SUPPLIER_WEBHOOK_SECRET || '');\nif (!secret) throw new Error('EU_SUPPLIER_WEBHOOK_SECRET missing');\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + raw).digest('hex');\nreturn [{ json: { body, raw, timestamp, signature }  } ];",
        "mode": "runOnceForEachItem"
      }
    },
