        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const baseUrl = 'https://ops.neontrip.de';\nconst workflowPart = String($workflow.id || '').replace(/[^A-Za-z0-9._:-]/g, '').slice(0, 32);\nconst executionPart = String($execution.id || '').replace(/[^A-Za-z0-9._:-]/g, '').slice(0, 32);\nconst workerId = ('n8n-outlook-archive:' + workflowPart + ':' + executionPart).slice(0, 96);\nif (!/^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$/.test(workerId)) throw new Error('Outlook archive worker id is invalid');\nreturn [{ json: { baseUrl, workerId } }];"
        }
