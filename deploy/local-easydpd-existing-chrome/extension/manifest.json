{
  "manifest_version": 3,
  "name": "NEONTRIP EasyDPD Existing Chrome Bridge",
  "version": "1.1.0",
  "description": "Verarbeitet freigegebene NEONTRIP-EasyDPD-Aufträge im bereits geöffneten Shopify-Tab.",
  "key": "",
  "permissions": [
    "alarms",
    "downloads",
    "nativeMessaging",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://admin.shopify.com/store/galaxybuzzdk/apps/dpd-versand-services/*",
    "https://easydpd.247apps.de/*"
  ],
  "background": {
    "service_worker": "service_worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://easydpd.247apps.de/*"
      ],
      "js": [
        "content_script.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
