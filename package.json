{
  "name": "neontrip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:voice-runtime": "tsc -p tsconfig.voice-runtime.json",
    "eval:voice": "node --import tsx scripts/run_voice_platform_evals.ts",
    "eval:voice:live": "node --import tsx scripts/run_voice_platform_live_evals.ts",
    "check:ops-deploy": "node scripts/check_customer_records_deploy_env.mjs",
    "check:ops-schema": "node scripts/check_customer_records_schema.mjs",
    "go-live:ops": "node scripts/go_live_customer_records_ops.mjs",
    "smoke:ops": "node scripts/smoke_customer_records_ops.mjs",
    "smoke:company-brain-ui": "node scripts/smoke_company_brain_ui.mjs",
    "smoke:company-brain-governance-ui": "node scripts/smoke_company_brain_governance_ui.mjs",
    "smoke:sales-vergabe-ui": "node scripts/smoke_sales_vergabe_ui.mjs",
    "start": "next start",
    "arrival-labels:dry-run": "node --import tsx scripts/run_arrival_labels.ts --mode dry_run",
    "lint": "next lint",
    "verify": "npm run test:quotes && npm run build:voice-runtime && npm run build",
    "test:quotes": "node --import tsx --test tests/quotes/*.test.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@napi-rs/canvas": "1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.475.0",
    "next": "15.5.18",
    "openai": "6.46.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "8.18.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.18",
    "playwright": "^1.59.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
